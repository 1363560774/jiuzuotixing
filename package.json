{
  "name": "stand-up-reminder",
  "version": "1.0.2",
  "description": "久坐提醒 - Stand Up Reminder",
  "author": "kai",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --mac --dir"
  },
  "build": {
    "appId": "com.standup.reminder",
    "productName": "久坐提醒",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "tray-modal.html",
      "assets/**",
      "updater.js"
    ],
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "target": [
        {
          "target": "dmg"
        }
      ],
      "darkModeSupport": true,
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "久坐提醒"
    },
    "afterPack": "./scripts/remove-quarantine.js",
    "dmg": {
      "title": "StandUpReminder",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "1363560774",
      "repo": "jiuzuotixing"
    },
    "artifactName": "stand-up-reminder-${version}-${arch}.${ext}"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
