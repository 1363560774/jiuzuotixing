{
  "name": "stand-up-reminder",
  "version": "1.0.0",
  "description": "久坐提醒 - Stand Up Reminder",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build:dir": "electron-builder --mac --dir"
  },
  "build": {
    "appId": "com.standup.reminder",
    "productName": "久坐提醒",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "tray-modal.html"
    ],
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "afterPack": "./scripts/remove-quarantine.js",
    "dmg": {
      "title": "久坐提醒安装程序",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
